{
  "name": "project-manager-training",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:data && tsc --noEmit && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "validate:data": "python3 scripts/validate_data.py"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "1.64.0"
  }
}
